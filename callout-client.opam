# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Callout CAD web frontend"
license: "Apache-2.0"
homepage: "https://github.com/Zaneham/callout"
bug-reports: "https://github.com/Zaneham/callout/issues"
depends: [
  "dune" {>= "3.0"}
  "callout-shared"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "js_of_ocaml-lwt"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Zaneham/callout.git"
